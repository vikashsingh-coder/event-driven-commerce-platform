{
  "name": "ecommerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Event driven microservices ecommerce platform",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:restart": "docker compose restart",
    "infra:ps": "docker compose ps",
    "infra:check": "./scripts/check-infrastructure.sh",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.10",
    "typescript": "^5.8.0"
  }
}
